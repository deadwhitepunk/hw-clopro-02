#cloud-config
users:
  - name: user
    groups: sudo
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ssh-ed25519 
runcmd:
  - [ sh, -c, "echo '<html><head><title>Kitty</title></head><body><h1>Best Kitty</h1><img src=\"https://storage.yandexcloud.net/${bucket_domain}/${object_key}\" /></body></html>' > /var/www/html/index.html" ]